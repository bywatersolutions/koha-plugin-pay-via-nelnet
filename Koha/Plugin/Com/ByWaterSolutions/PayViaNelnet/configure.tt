[% INCLUDE 'doc-head-open.inc' %]
 <title>Koha: Plugin: Pay Via Nelnet: Configuration</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div id="breadcrumbs"><a href="/cgi-bin/koha/mainpage.pl">Home</a> &rsaquo; <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a> &rsaquo; Pay Via Nelnet &rsaquo; Configuration</div>

<div id="doc3">
    <!-- We can access our own plugins resource files using the PLUGIN_PATH variable. -->
    <h3>Koha: Plugin: Pay Via Nelnet: Configuration</h3>

	[% UNLESS encryption_available %]
	  <div class="dialog alert">
		<strong>Koha's encryption is not available.</strong>
		The key can only be stored in cleartext until an <code>encryption_key</code> is set in
		<code>koha-conf.xml</code>. Add one (we recommend at least 32 bytes, for example
		<code>pwgen 32 1</code>), restart Koha, then reopen this page and the stored key will be
		encrypted automatically.
	  </div>
	[% ELSIF key_is_set AND NOT key_is_encrypted %]
	  <div class="dialog alert">
		<strong>The stored key is not encrypted.</strong>
		Re-enter it below and save to store it encrypted.
	  </div>
	[% END %]

	<form method='post'>
	  <input type="hidden" name="class" value="[% CLASS %]"/>
	  <input type="hidden" name="method" value="[% METHOD %]"/>
	  <input type="hidden" name="save" value="1" />
	  [% IF csrf_token %]<input type="hidden" name="csrf_token" value="[% csrf_token | html %]" />[% END %]

	  <div class="form-group">
			<label for="enable_opac_payments">Enable OPAC Account Payments: </label>
			<select class="form-control" name="enable_opac_payments">
				[% IF enable_opac_payments == 'No' %]
					<option value="No" selected="selected">No</option>
				[% ELSE %]
					<option value="No">No</option>
				[% END %]

				[% IF enable_opac_payments == 'Yes' %]
					<option value="Yes" selected="selected">Yes</option>
				[% ELSE %]
					<option value="Yes">Yes</option>
				[% END %]
			</select>
	  </div>

	  <div class="form-group">
		<label for="url">Payment URL</label>
		<input type="text" class="form-control" id="url" name="url" value="[% url | html %]" />
	  </div>

	  <div class="form-group">
		<label for="orderType">Order Type: </label>
		<input type="text" class="form-control" id="orderType" name="orderType" value="[% orderType | html %]" />
	  </div>

	  <div class="form-group">
		<label for="key">Key: </label>
		<input type="password" class="form-control" id="key" name="key" value="" autocomplete="new-password" />
		<p class="help-block">
		  [% IF key_is_set %]
			A key is already stored. Leave this blank to keep it, or enter a new one to replace it.
		  [% ELSE %]
			No key is stored yet.
		  [% END %]
		</p>
	  </div>

	  <button type="submit" class="btn btn-default">Save</button>
	</form>

[% INCLUDE 'intranet-bottom.inc' %]
